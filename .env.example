# Live, bookable prices. Sign up at https://ignav.com/signup (first 1,000 requests free).
IGNAV_API_KEY=
# Free cached prices for the month scan. Token from https://www.travelpayouts.com/programs/100/tools/api
TRAVELPAYOUTS_TOKEN=

# Optional
# IGNAV_MARKET=NL             # Country for pricing and currency (NL = euros)
# TRAVELPAYOUTS_MARKET=       # e.g. nl; empty = Travelpayouts default
# DEFAULT_LIVE_BUDGET=25      # Live checks per search, pre-filled in the form
# MAX_LIVE_BUDGET=150         # Upper limit for the slider
# DEMO_MODE=false             # true = fake prices even when keys are set
